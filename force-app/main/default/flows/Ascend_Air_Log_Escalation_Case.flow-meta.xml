<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Case_Number</name>
        <label>Set Case Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>caseNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>caseRecord.CaseNumber</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Booking_Found</name>
        <label>Check Booking Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Booking Found</defaultConnectorLabel>
        <rules>
            <name>Booking_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>bookingRecord.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case_Unverified</targetReference>
            </connector>
            <label>Booking Missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Last_Name</name>
        <label>Check Last Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Case_Unverified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Last Name Mismatch</defaultConnectorLabel>
        <rules>
            <name>Last_Name_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lastNameMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case_Verified</targetReference>
            </connector>
            <label>Last Name Matches</label>
        </rules>
    </decisions>
    <formulas>
        <name>cleanPnr</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!pnr}))</expression>
    </formulas>
    <formulas>
        <name>cleanLastName</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!lastName}))</expression>
    </formulas>
    <formulas>
        <name>lastNameMatches</name>
        <dataType>Boolean</dataType>
        <expression>{!cleanLastName} = UPPER({!contactRecord.LastName})</expression>
    </formulas>
    <formulas>
        <name>casePriority</name>
        <dataType>String</dataType>
        <expression>IF({!reason} = "Departure Within 2 Hours", "High", "Medium")</expression>
    </formulas>
    <formulas>
        <name>subjectLine</name>
        <dataType>String</dataType>
        <expression>"Ascend Air agent escalation: " &amp; {!reason}</expression>
    </formulas>
    <formulas>
        <name>verifiedDescription</name>
        <dataType>String</dataType>
        <expression>"PNR " &amp; {!bookingRecord.PNR__c} &amp; " | Flight " &amp; {!bookingRecord.Flight_Number__c} &amp; " | Seat " &amp; {!bookingRecord.Seat__c} &amp; " | " &amp; {!summary}</expression>
    </formulas>
    <interviewLabel>Ascend Air - Log Escalation Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Ascend Air - Log Escalation Case</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Case_Verified</name>
        <label>Create Case Verified</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>newCaseId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>subjectLine</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <elementReference>casePriority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>verifiedDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>bookingRecord.Contact__c</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Case_Unverified</name>
        <label>Create Case Unverified</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>newCaseId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>subjectLine</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <elementReference>casePriority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>summary</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Booking</name>
        <label>Get Booking</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Booking_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PNR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>cleanPnr</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking__c</object>
        <outputReference>bookingRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PNR__c</queriedFields>
        <queriedFields>Flight_Number__c</queriedFields>
        <queriedFields>Seat__c</queriedFields>
        <queriedFields>Contact__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Case_Number</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>newCaseId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Last_Name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>bookingRecord.Contact__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>contactRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>LastName</queriedFields>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Booking</targetReference>
        </connector>
    </start>
    <status>Active</status>
