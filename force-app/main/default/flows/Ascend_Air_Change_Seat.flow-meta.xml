    <recordLookups>
        <name>Get_Taken_Seat</name>
        <label>Get Taken Seat</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Seat_Taken</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Flight_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>bookingRecord.Flight_Number__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Departure_Date_Time__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>bookingRecord.Departure_Date_Time__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Seat__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>seatNorm</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>bookingRecord.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking__c</object>
        <outputReference>takenSeatRecord</outputReference>
        <queriedFields>Id</queriedFields>
