            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>seatIsExtraLegroom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
