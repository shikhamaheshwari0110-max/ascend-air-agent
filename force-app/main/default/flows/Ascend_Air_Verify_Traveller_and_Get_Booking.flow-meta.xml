<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Verified_Outputs</name>
        <label>Set Verified Outputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>verified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>flightNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>bookingRecord.Flight_Number__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>departureDateTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>bookingRecord.Departure_Date_Time__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>seat</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>bookingRecord.Seat__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>cabin</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>bookingRecord.Cabin__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>fareClass</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>bookingRecord.Fare_Class__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>withinTwoHours</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>withinTwoHoursFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Verified.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Not_Verified</name>
        <label>Set Not Verified</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>verified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Booking reference and last name do not match our records.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Booking_Found</name>
        <label>Check Booking Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Booking Found</defaultConnectorLabel>
        <rules>
            <name>Booking_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>bookingRecord.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Verified</targetReference>
            </connector>
            <label>Booking Missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Last_Name</name>
        <label>Check Last Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Verified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Last Name Mismatch</defaultConnectorLabel>
        <rules>
            <name>Last_Name_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lastNameMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Verified_Outputs</targetReference>
            </connector>
            <label>Last Name Matches</label>
        </rules>
    </decisions>
    <formulas>
        <name>cleanPnr</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!pnr}))</expression>
    </formulas>
    <formulas>
        <name>cleanLastName</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!lastName}))</expression>
    </formulas>
    <formulas>
        <name>lastNameMatches</name>
        <dataType>Boolean</dataType>
        <expression>{!cleanLastName} = UPPER({!contactRecord.LastName})</expression>
    </formulas>
    <formulas>
        <name>twoHourCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (120 / 1440)</expression>
    </formulas>
    <formulas>
        <name>withinTwoHoursFormula</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!bookingRecord.Departure_Date_Time__c}), {!bookingRecord.Departure_Date_Time__c} &lt; {!twoHourCutoff})</expression>
    </formulas>
    <interviewLabel>Ascend Air - Verify Traveller and Get Booking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Ascend Air - Verify Traveller and Get Booking</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Booking</name>
        <label>Get Booking</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Booking_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PNR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>cleanPnr</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking__c</object>
        <outputReference>bookingRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PNR__c</queriedFields>
        <queriedFields>Flight_Number__c</queriedFields>
        <queriedFields>Departure_Date_Time__c</queriedFields>
        <queriedFields>Seat__c</queriedFields>
        <queriedFields>Cabin__c</queriedFields>
        <queriedFields>Fare_Class__c</queriedFields>
        <queriedFields>Contact__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Last_Name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>bookingRecord.Contact__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>contactRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Booking</targetReference>
        </connector>
    </start>
    <status>Active</status>
